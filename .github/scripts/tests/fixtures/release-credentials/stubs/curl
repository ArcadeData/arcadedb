#
# Stub `curl` for test-ci-scripts.sh: check-release-credentials.sh against answers laid out under $STUB_DIR, never
# against the network. Each URL maps to a service by host:
#
#   keyserver.ubuntu.com -> ubuntu, keys.openpgp.org -> openpgp, central.sonatype.com -> central,
#   auth.docker.io -> docker, api.github.com -> github
#
#   $STUB_DIR/http/<service>.code   HTTP status to answer (absent: 200; github absent: 404)
#   $STUB_DIR/http/<service>.body   body written to the -o file (absent: empty)
#   $STUB_DIR/calls.log             one line per call: the URL, then every `-H @file` header's content

set -euo pipefail

out=""
url=""
headers=()
while [[ $# -gt 0 ]]; do
    case "$1" in
    -o) out="$2"; shift 2 ;;
    -w | --max-time) shift 2 ;;
    -H) headers+=("$2"); shift 2 ;;
    https://*) url="$1"; shift ;;
    *) shift ;;
    esac
done

case "$url" in
https://keyserver.ubuntu.com/*) service=ubuntu ;;
https://keys.openpgp.org/*) service=openpgp ;;
https://central.sonatype.com/*) service=central ;;
https://auth.docker.io/*) service=docker ;;
https://api.github.com/*) service=github ;;
*) echo "stub curl: unexpected URL $url" >&2; exit 6 ;;
esac

{
    echo "$url"
    for h in ${headers[@]+"${headers[@]}"}; do
        if [[ $h == @* ]]; then cat "${h#@}"; else echo "$h"; fi
    done
} >>"$STUB_DIR/calls.log"

default=200
[[ $service == github ]] && default=404
code="$(cat "$STUB_DIR/http/$service.code" 2>/dev/null || echo "$default")"
if [[ -n $out ]]; then
    cat "$STUB_DIR/http/$service.body" >"$out" 2>/dev/null || : >"$out"
fi
printf '%s' "$code"
