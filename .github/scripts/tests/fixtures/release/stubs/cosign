# Stub `cosign` for test-ci-scripts.sh. Logs each call to $STUB_DIR/calls.log. `sign-blob --bundle <b>` writes <b>.
# Any verify subcommand fails when its whole argument line matches the ERE in $STUB_DIR/fail-cosign.

set -euo pipefail

: "${STUB_DIR:?STUB_DIR must be set}"
echo "cosign $*" >>"$STUB_DIR/calls.log"

case "$1" in
sign-blob)
    prev=""
    for a in "$@"; do
        [[ $prev == --bundle ]] && echo '{"stub":"bundle"}' >"$a"
        prev="$a"
    done
    ;;
verify | verify-blob | verify-attestation)
    if [[ -f "$STUB_DIR/fail-cosign" ]] && echo "$*" | grep -Eqf "$STUB_DIR/fail-cosign"; then
        echo "Error: no matching signatures" >&2
        exit 1
    fi
    ;;
*)
    echo "stub cosign: unsupported command: $*" >&2
    exit 64
    ;;
esac
