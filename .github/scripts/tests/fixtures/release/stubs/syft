# Stub `syft` for test-ci-scripts.sh: `convert <in> -o <format>=<out>` writes a minimal SPDX document to <out>.

set -euo pipefail

: "${STUB_DIR:?STUB_DIR must be set}"
echo "syft $*" >>"$STUB_DIR/calls.log"

[[ $1 == convert ]] || { echo "stub syft: unsupported command: $*" >&2; exit 64; }
prev=""
for a in "$@"; do
    [[ $prev == -o ]] && printf '{"spdxVersion":"SPDX-2.3","name":"%s"}\n' "$(basename "$2")" >"${a#*=}"
    prev="$a"
done
