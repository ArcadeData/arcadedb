<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.arcadedb</groupId>
        <artifactId>arcadedb-parent</artifactId>
        <version>26.11.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>arcadedb-census</artifactId>
    <packaging>jar</packaging>
    <name>ArcadeDB Census</name>
    <description>
        Check-only module (ships nothing). Holds the censuses that range over the compiled classes of EVERY module, the
        engine included: a module's own tests run before the modules that depend on it are compiled, so a census living
        in one of them can only read its own classes and the ones below it, and a source-text census can be passed by a
        spelling (issue #11197). Every main module is a test-scoped dependency with its own dependencies excluded: the
        census reads the class files, it loads none of them. Must build after every module it lists.
    </description>

    <properties>
        <!-- This module ships nothing; do not deploy or install it. -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.install.skip>true</maven.install.skip>
    </properties>

    <dependencies>
        <!-- The modules the census reads. A module with main sources that is missing here fails the census, which
             lists the modules from the source tree rather than from this file. -->
        <dependency>
            <groupId>com.arcadedb</groupId>
            <artifactId>arcadedb-engine</artifactId>
            <version>${project.parent.version}</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.arcadedb</groupId>
            <artifactId>arcadedb-network</artifactId>
            <version>${project.parent.version}</version>
            <scope>test</scope>
            <exclusions>
