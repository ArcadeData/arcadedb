# linux/arm64 ONLY. Packages the mostly-static glibc binary built by native-image.yml's
# linux/arm64 job (-Dnative.mostlystatic=true, native/pom.xml's native-mostly-static profile:
# -H:+StaticExecutableWithDynamicLibC). Everything is statically linked except glibc itself,
# which is loaded dynamically at runtime (matching glibc's own NSS/dlopen requirements), so this
# binary needs a glibc runtime - unlike the fully-static musl amd64 binary, which needs nothing
# and runs on `scratch` (see Dockerfile.native.scratch). GraalVM CE ships no static musl JDK
# libraries for aarch64 (oracle/graal#4645, closed not-planned), so the fully-static/musl
# combination cannot link on this architecture; -H:+StaticExecutableWithDynamicLibC is GraalVM's
# documented fallback for exactly this case.
#
# distroless/base-debian12 provides glibc, libssl and a CA-certificate bundle already baked in -
# no separate ca-certificates COPY needed here, unlike Dockerfile.native.scratch - but no shell
# and no package manager: the same "no JAVA_OPTS wrapper script" constraint documented in
# Dockerfile.native.scratch's ENTRYPOINT comment applies here too.
#
# Runs as 1000:1000 (see `USER` below), the UID/GID of the JVM image's `arcadedb` user and of the
# amd64 scratch image, so the three images' volumes are interchangeable (issue #10319). This uses
# the plain base-debian12 tag rather than `:nonroot`: that tag only adds a `nonroot` (65532) entry
# to /etc/passwd, which the binary has no use for - `USER` takes a numeric UID:GID with no passwd
# entry. Images before #10319 ran as 65532, so volumes they wrote need a one-time
# `chown -R 1000:1000` before this image can open them.
#
# Pinned by digest (in addition to the tag, kept for readability) to match the JVM Dockerfile's
# supply-chain posture: a floating tag can be repointed upstream without notice, while the digest
# guarantees the exact image content this Dockerfile was validated against. Resolve the current
# digest with:
#   docker buildx imagetools inspect gcr.io/distroless/base-debian12:latest --format '{{.Manifest.Digest}}'
#
# Tiny builder stage: distroless/base has no shell/mkdir/chown to create the VOLUME directories
# below owned by the 1000:1000 runtime user, so pre-create them here and COPY the resulting tree
# in. Docker initializes an anonymous volume with the ownership of the image directory it is
# mounted on, so these directories decide who can write a fresh volume. Pinned by digest,
# matching the base image's own pin above.
FROM busybox:1.37.0-musl@sha256:222ad6d973c0d198014546a65cd02c5fdedcc172123c5b4c2bf0af636550bd94 AS dirs
RUN mkdir -p /skel/bin /skel/config /skel/databases /skel/backups /skel/replication /skel/log && \
    chown -R 1000:1000 /skel

FROM gcr.io/distroless/base-debian12:latest@sha256:fabbf1c0c357a3d42550111351daed089b20a2c954df13ee2fcff60602515e84

LABEL maintainer="Arcade Data LTD (info@arcadedb.com)"

# Build-time inputs staged into the build context by native-image.yml's `docker` job (see its
# "Stage build context" step, arm64 leg):
#   ./arcadedb -> the linux/arm64 mostly-static binary, from artifact arcadedb-native-linux-arm64
#   ./config   -> config templates from package/src/main/config, with the JVM
#                 assemblies' include set
COPY --from=dirs --chown=1000:1000 /skel/ /home/arcadedb/
COPY --chown=1000:1000 config /home/arcadedb/config
COPY --chown=1000:1000 --chmod=0755 arcadedb /home/arcadedb/bin/arcadedb

WORKDIR /home/arcadedb

USER 1000:1000

VOLUME [ "/home/arcadedb/config" ]
VOLUME [ "/home/arcadedb/databases" ]
VOLUME [ "/home/arcadedb/backups" ]
VOLUME [ "/home/arcadedb/replication" ]
VOLUME [ "/home/arcadedb/log" ]

# ArcadeDB HTTP API & Studio
EXPOSE 2480
# Raft gRPC (replication)
EXPOSE 2434
# PostgreSQL wire protocol
EXPOSE 5432
# Redis wire protocol
EXPOSE 6379
# MongoDB wire protocol
EXPOSE 27017
# Neo4j Bolt wire protocol
EXPOSE 7687
# gRPC service
EXPOSE 50051

# distroless/base has no shell either, so the same exec-form, no-wrapper-script constraints as
# Dockerfile.native.scratch's ENTRYPOINT apply here (see its comment for the full rationale).
# The image already runs as 1000:1000 (see `USER` above), so no --user override is required at
# `docker run` time. See docs/native-image.md for a full worked example.
# -Duser.home: UID 1000 has no /etc/passwd entry in either base, so the JVM cannot look its home
# directory up and would leave user.home unusable (the `%h` of a log file pattern resolves through it).
ENTRYPOINT ["/home/arcadedb/bin/arcadedb", \
  "-Duser.home=/home/arcadedb", \
  "-Dorg.jline.terminal.dumb=true", \
  "-Djava.util.logging.config.file=/home/arcadedb/config/arcadedb-log.properties"]
