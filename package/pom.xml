                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.arcadedb</groupId>
            <artifactId>arcadedb-graphql</artifactId>
            <version>${project.parent.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- Runtime SLF4J binding bundled into the distribution: routes third-party SLF4J logs
             (dependencies) to java.util.logging. Declared here at runtime because the parent keeps
             slf4j-jdk14 at test scope so it does not leak to consumers of the library modules. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-jdk14</artifactId>
            <version>${slf4j.version}</version>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!--
         | Release-level SBOM per distribution, shipped inside it as sbom/arcadedb-<v>[-<assembly>].cdx.json.
         |
         | The package module's own BOM describes its whole runtime classpath, which is not what any single
         | archive ships (base leaves out Studio, the console and the wire protocols) and misses Studio's npm
         | tree entirely. So, before the archives are built at `package`:
         |   process-resources  makeBom on this module, and each assembly laid out once more as a bare `dir`
         |                      under target/sbom-staging from the SAME descriptor, so its lib/ is exactly the
         |                      set the archive will contain
         |   prepare-package    merge-sbom.py keeps the BOM components whose jar is in that lib/ (checking each
         |                      SHA-256, failing on a jar the BOM does not describe), nests under each shaded
         |                      jar the libraries its module shades in (from <module>/target/*-cyclonedx.json,
         |                      minus the module's shade artifactSet excludes), nests Studio's npm BOM where
         |                      the Studio jar ships, adds every artifact a shipped jar carries in
         |                      META-INF/maven/ that is not listed yet (e.g. Netty inside ratis-thirdparty inside
         |                      the ha-raft uber-jar), licensed from the local repository, and stamps supplier
         |                      and timestamp
         |   package            the assemblies pick target/sbom/<assembly>/ up as sbom/
         | Only under -Pdeploy, and it needs python3 (3.9+, standard library only) on the PATH: the release
         | runners have it, developer builds without -Pdeploy never call it. It also needs Maven online:
         | cyclonedx-maven-plugin skips makeBom under -o, and merge-sbom.py then fails on the missing BOM.
         | minimal and headless are disabled above; re-enabling one needs its own staging and merge execution here.
        -->
        <profile>
            <id>deploy</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.cyclonedx</groupId>
                        <artifactId>cyclonedx-maven-plugin</artifactId>
                        <version>${cyclonedx-maven-plugin.version}</version>
                        <configuration>
                            <projectType>application</projectType>
                        </configuration>
                        <executions>
                            <execution>
                                <id>make-sbom</id>
                                <phase>process-resources</phase>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <!-- Configuration per execution, never at plugin level: a profile's plugin-level
                             configuration merges into the full and base executions above as well, and
                             would turn the real archives into bare directories. -->
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-assembly-plugin</artifactId>
                        <version>${maven-assembly-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>full-sbom-staging</id>
                                <phase>process-resources</phase>
                                <goals>
                                    <goal>single</goal>
                                </goals>
                                <configuration>
                                    <formats>
                                        <format>dir</format>
                                    </formats>
                                    <attach>false</attach>
                                    <outputDirectory>${project.build.directory}/sbom-staging</outputDirectory>
                                    <finalName>arcadedb-${project.version}</finalName>
                                    <ignoreDirFormatExtensions>false</ignoreDirFormatExtensions>
                                    <appendAssemblyId>false</appendAssemblyId>
                                    <descriptors>
                                        <descriptor>./src/main/assembly/full.xml</descriptor>
                                    </descriptors>
                                </configuration>
                            </execution>
                            <execution>
                                <id>base-sbom-staging</id>
                                <phase>process-resources</phase>
                                <goals>
                                    <goal>single</goal>
                                </goals>
                                <configuration>
                                    <formats>
                                        <format>dir</format>
                                    </formats>
                                    <attach>false</attach>
                                    <outputDirectory>${project.build.directory}/sbom-staging</outputDirectory>
                                    <finalName>arcadedb-${project.version}</finalName>
                                    <ignoreDirFormatExtensions>false</ignoreDirFormatExtensions>
                                    <appendAssemblyId>true</appendAssemblyId>
                                    <descriptors>
                                        <descriptor>./src/main/assembly/base.xml</descriptor>
                                    </descriptors>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>${exec-maven-plugin.version}</version>
                        <configuration>
                            <executable>python3</executable>
                        </configuration>
                        <executions>
                            <execution>
                                <id>full-sbom</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <arguments>
                                        <argument>${project.basedir}/../.github/scripts/merge-sbom.py</argument>
                                        <argument>--root</argument>
                                        <argument>${project.build.directory}/${project.build.finalName}-cyclonedx.json</argument>
                                        <argument>--nested</argument>
                                        <argument>${project.basedir}/../studio/target/studio.cdx.json</argument>
                                        <argument>--name</argument>
                                        <argument>arcadedb-studio</argument>
                                        <argument>--module-boms</argument>
                                        <argument>${project.basedir}/../*/target/*-cyclonedx.json</argument>
                                        <argument>--maven-repo</argument>
                                        <argument>${settings.localRepository}</argument>
                                        <argument>--lib-dir</argument>
                                        <argument>${project.build.directory}/sbom-staging/arcadedb-${project.version}.dir/arcadedb-${project.version}/lib</argument>
                                        <argument>--supplier</argument>
                                        <argument>Arcade Data Ltd</argument>
                                        <argument>--supplier-url</argument>
                                        <argument>https://arcadedb.com</argument>
                                        <argument>--timestamp</argument>
                                        <argument>--out</argument>
                                        <argument>${project.build.directory}/sbom/full/arcadedb-${project.version}.cdx.json</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>base-sbom</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <arguments>
                                        <argument>${project.basedir}/../.github/scripts/merge-sbom.py</argument>
                                        <argument>--root</argument>
                                        <argument>${project.build.directory}/${project.build.finalName}-cyclonedx.json</argument>
                                        <argument>--nested</argument>
                                        <argument>${project.basedir}/../studio/target/studio.cdx.json</argument>
                                        <argument>--name</argument>
                                        <argument>arcadedb-studio</argument>
                                        <argument>--module-boms</argument>
                                        <argument>${project.basedir}/../*/target/*-cyclonedx.json</argument>
                                        <argument>--maven-repo</argument>
                                        <argument>${settings.localRepository}</argument>
                                        <argument>--lib-dir</argument>
                                        <argument>${project.build.directory}/sbom-staging/arcadedb-${project.version}-base.dir/arcadedb-${project.version}/lib</argument>
                                        <argument>--supplier</argument>
                                        <argument>Arcade Data Ltd</argument>
                                        <argument>--supplier-url</argument>
                                        <argument>https://arcadedb.com</argument>
                                        <argument>--timestamp</argument>
                                        <argument>--out</argument>
                                        <argument>${project.build.directory}/sbom/base/arcadedb-${project.version}-base.cdx.json</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>multiplatform</id>
            <activation>
                <os>
                    <family>unix</family>
                </os>
            </activation>
            <properties>
                <docker-maven-plugin.platform>linux/amd64,linux/arm64</docker-maven-plugin.platform>
            </properties>
        </profile>
        <profile>
            <id>docker</id>
            <build>
                <plugins>
                    <plugin>
                        <artifactId>maven-resources-plugin</artifactId>
                        <version>${maven-resources-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>copy-resources-full</id>
                                <phase>validate</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.build.directory}/arcadedb-${project.version}.dir
                                    </outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>src/main/docker</directory>
                                            <includes>
                                                <include>Dockerfile</include>
                                            </includes>
                                            <filtering>false</filtering>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
<!-- Disabled: minimal/headless distributions are not worth the saved KB
                            <execution>
                                <id>copy-resources-minimal</id>
                                <phase>validate</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.build.directory}/arcadedb-${project.version}-minimal.dir
                                    </outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>src/main/docker</directory>
                                            <includes>
                                                <include>Dockerfile</include>
                                            </includes>
                                            <filtering>false</filtering>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
-->
<!-- Disabled: minimal/headless distributions are not worth the saved KB
                            <execution>
                                <id>copy-resources-headless</id>
                                <phase>validate</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.build.directory}/arcadedb-${project.version}-headless.dir
                                    </outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>src/main/docker</directory>
                                            <includes>
                                                <include>Dockerfile</include>
                                            </includes>
                                            <filtering>false</filtering>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
-->
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>io.fabric8</groupId>
                        <artifactId>docker-maven-plugin</artifactId>
                        <version>${docker-maven-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>default</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>build</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>deploy</id>
                                <phase>deploy</phase>
                                <goals>
                                    <goal>push</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <verbose>true</verbose>
                            <images>
                                <image>
                                    <name>${docker.image.prefix}/arcadedb</name>
                                    <build>
                                        <contextDir>${project.build.directory}/arcadedb-${project.version}.dir
                                        </contextDir>
                                        <buildx>
                                            <platforms>
                                                <platform>${docker-maven-plugin.platform}</platform>
                                            </platforms>
                                        </buildx>
                                        <tags>
                                            <tag>latest</tag>
                                            <tag>${project.version}</tag>
                                        </tags>
                                    </build>
                                </image>
<!-- Disabled: not worth the saved KB
                                <image>
                                    <name>arcadedata/arcadedb-minimal</name>
                                    <build>
                                        <contextDir>${project.build.directory}/arcadedb-${project.version}-minimal.dir
                                        </contextDir>
                                        <buildx>
                                            <platforms>
                                                <platform>${docker-maven-plugin.platform}</platform>
                                            </platforms>
                                        </buildx>
                                        <tags>
                                            <tag>latest</tag>
                                            <tag>${project.version}</tag>
                                        </tags>
                                    </build>
                                </image>
-->
<!-- Disabled: not worth the saved KB
                                <image>
                                    <name>arcadedata/arcadedb-headless</name>
                                    <build>
                                        <contextDir>${project.build.directory}/arcadedb-${project.version}-headless.dir
                                        </contextDir>
                                        <buildx>
                                            <platforms>
                                                <platform>${docker-maven-plugin.platform}</platform>
                                            </platforms>
                                        </buildx>
                                        <tags>
                                            <tag>latest</tag>
                                            <tag>${project.version}</tag>
                                        </tags>
                                    </build>
                                </image>
-->
                            </images>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
