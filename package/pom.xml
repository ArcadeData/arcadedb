                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.arcadedb</groupId>
            <artifactId>arcadedb-grpcw</artifactId>
            <version>${project.parent.version}</version>
            <classifier>shaded</classifier>
            <exclusions>
                <exclusion>
