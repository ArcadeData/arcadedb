        <groupId>com.arcadedb</groupId>
        <artifactId>arcadedb-parent</artifactId>
        <version>26.12.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>arcadedb-package</artifactId>
    <packaging>pom</packaging>
    <name>ArcadeDB Package</name>
    <properties>
        <kubernetes-maven-plugin.version>1.12.0</kubernetes-maven-plugin.version>
        <docker.buildArg.platform>arm64v8/,amd64/,winamd64/,arm32v7/</docker.buildArg.platform>
        <docker-maven-plugin.version>0.49.0</docker-maven-plugin.version>
        <docker-maven-plugin.platform>linux/amd64</docker-maven-plugin.platform>
        <!-- Docker Hub namespace of the image. A release rehearsal on a fork overrides it with the fork's own
             namespace (-Ddocker.image.prefix), so a rehearsal cannot push to arcadedata/arcadedb. -->
        <docker.image.prefix>arcadedata</docker.image.prefix>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>${maven-assembly-plugin.version}</version>
                <executions>
                    <execution>
                        <id>full</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <configuration>
                            <appendAssemblyId>false</appendAssemblyId>
                            <finalName>arcadedb-${project.version}</finalName>
                            <descriptors>
                                <descriptor>./src/main/assembly/full.xml</descriptor>
                            </descriptors>
                            <ignoreDirFormatExtensions>false</ignoreDirFormatExtensions>
                        </configuration>
                    </execution>
<!-- Disabled: minimal/headless distributions are not worth the saved KB
                    <execution>
                        <id>minimal</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <configuration>
                            <appendAssemblyId>true</appendAssemblyId>
                            <finalName>arcadedb-${project.version}</finalName>
                            <descriptors>
                                <descriptor>./src/main/assembly/minimal.xml</descriptor>
                            </descriptors>
                            <ignoreDirFormatExtensions>false</ignoreDirFormatExtensions>
                        </configuration>
                    </execution>
-->
<!-- Disabled: minimal/headless distributions are not worth the saved KB
                    <execution>
                        <id>headless</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <configuration>
                            <appendAssemblyId>true</appendAssemblyId>
                            <finalName>arcadedb-${project.version}</finalName>
                            <descriptors>
                                <descriptor>./src/main/assembly/headless.xml</descriptor>
                            </descriptors>
                            <ignoreDirFormatExtensions>false</ignoreDirFormatExtensions>
                        </configuration>
                    </execution>
-->
                    <execution>
                        <id>base</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <configuration>
                            <appendAssemblyId>true</appendAssemblyId>
                            <finalName>arcadedb-${project.version}</finalName>
                            <descriptors>
                                <descriptor>./src/main/assembly/base.xml</descriptor>
                            </descriptors>
                            <ignoreDirFormatExtensions>false</ignoreDirFormatExtensions>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>net.nicoulaj.maven.plugins</groupId>
                <artifactId>checksum-maven-plugin</artifactId>
                <version>1.11</version>
                <executions>
                    <execution>
                        <id>generate-checksums</id>
                        <phase>package</phase>
                        <goals>
                            <goal>files</goal>
                        </goals>
                        <configuration>
                            <algorithms>
                                <algorithm>SHA-256</algorithm>
                            </algorithms>
                            <fileSets>
                                <fileSet>
                                    <directory>${project.build.directory}</directory>
                                    <includes>
                                        <include>arcadedb-*.tar.gz</include>
                                        <include>arcadedb-*.zip</include>
                                    </includes>
                                </fileSet>
                            </fileSets>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
