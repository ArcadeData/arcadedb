<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.arcadedb</groupId>
        <artifactId>arcadedb-parent</artifactId>
        <version>26.9.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>arcadedb-ha-raft</artifactId>
    <packaging>jar</packaging>
    <name>ArcadeDB HA Raft</name>

    <properties>
        <ratis.version>3.2.2</ratis.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.arcadedb</groupId>
            <artifactId>arcadedb-engine</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
        <dependency>
            <groupId>com.arcadedb</groupId>
            <artifactId>arcadedb-network</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
        <dependency>
            <groupId>com.arcadedb</groupId>
            <artifactId>arcadedb-server</artifactId>
            <version>${project.parent.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.arcadedb</groupId>
            <artifactId>arcadedb-server</artifactId>
            <version>${project.parent.version}</version>
            <scope>test</scope>
            <type>test-jar</type>
        </dependency>

        <!-- Apache Ratis -->
        <dependency>
            <groupId>org.apache.ratis</groupId>
            <artifactId>ratis-server</artifactId>
            <version>${ratis.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.ratis</groupId>
            <artifactId>ratis-grpc</artifactId>
            <version>${ratis.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.ratis</groupId>
            <artifactId>ratis-metrics-default</artifactId>
            <version>${ratis.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.ratis</groupId>
            <artifactId>ratis-test</artifactId>
            <version>${ratis.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- MiniRaftCluster and RaftTestUtil are in test-jars of ratis-server and ratis-grpc.
             BaseTest (used by MiniRaftCluster) lives in the ratis-common test-jar. -->
        <dependency>
            <groupId>org.apache.ratis</groupId>
            <artifactId>ratis-common</artifactId>
            <version>${ratis.version}</version>
            <scope>test</scope>
            <type>test-jar</type>
        </dependency>
        <dependency>
            <groupId>org.apache.ratis</groupId>
            <artifactId>ratis-server</artifactId>
            <version>${ratis.version}</version>
            <scope>test</scope>
            <type>test-jar</type>
        </dependency>
        <dependency>
            <groupId>org.apache.ratis</groupId>
            <artifactId>ratis-grpc</artifactId>
            <version>${ratis.version}</version>
            <scope>test</scope>
            <type>test-jar</type>
        </dependency>

        <!-- Test dependencies -->
        <!-- arcadedb-integration is needed at runtime for the "backup database" SQL command -->
        <dependency>
            <groupId>com.arcadedb</groupId>
            <artifactId>arcadedb-integration</artifactId>
            <version>${project.parent.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- SLF4J-JDK14 bridge: routes Ratis SLF4J logs through java.util.logging
             so they appear in ArcadeDB's AnsiLogFormatter format.
             Do NOT add logback-classic here; it would hijack SLF4J binding. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-jdk14</artifactId>
            <version>${slf4j.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
            </plugin>

            <!-- Issue #6343, item 2: the heaviest ITs in this module no longer share a JVM with the rest.
                 =====================================================================================

                 The parent runs failsafe with reuseForks=true and forkCount=1, so every IT in a module shares
                 one JVM with everything that ran before it. In this module that is 123 IT classes and roughly
                 an hour of continuous three-node cluster work in a single process, and it is the setting behind
                 the only stalls this module has ever produced that nobody could reproduce in isolation: two CI
                 runs (31578870619, 31587763511) in which Issue5410AbandonedTicketReleaseIT consumed its ENTIRE
                 poll budget immediately after RaftMigrationCompactionRaceIT - 72k records, 24 compaction rounds,
                 12 writer threads - had run in the same fork. That bought a 120s resync budget on a suspicion;
                 see BaseRaftHATest.RESYNC_RETRY_TIMEOUT_MS for how the measurements since took it back to 15s.

                 MEASURED FIRST, as issue #6343 asked. Forty full ha-integration-tests runs on main between
                 2026-08-18 and 2026-08-26:
                   - the lane costs 59.7-71.8 minutes (p50 62.2, p90 68.2) against a 90-minute job timeout, so
                     roughly twenty minutes of headroom exist and no more;
                   - the sum of per-class elapsed times is ~3600s of that, i.e. the JVM is busy essentially the
                     whole time;
                   - the class order was byte-for-byte identical in all forty runs, but it is failsafe's
                     filesystem order, not a declared one - and it has already drifted since those stalls, so
                     the adjacency that caused them does not even exist any more. "Immediately after
                     RaftMigrationCompactionRaceIT" is now Issue5064CommittedRemotelyContractIT.

                 That last point is why this is a split rather than reuseForks=false for the whole module. A
                 fresh JVM per class would settle the question outright, but it buys 122 extra JVM starts plus
                 the loss of all cross-class JIT warm-up, against twenty minutes of headroom - and it would be
                 paying that on every run forever to defend against an adjacency that is one `ls` away from
                 rearranging itself again. Isolating the classes that generate the pressure costs four extra
                 JVM starts and removes the hazard at its source: whatever a heavy IT leaves behind - heap it
                 churned, threads it did not join, page cache it dirtied - dies with its fork instead of being
                 inherited by whatever ran next. It works in either execution order, so it does not quietly
                 depend on Maven running the inherited execution first.

                 Deliberately NOT changed: runOrder. With the heavy classes hoisted out, reordering the other
                 118 would be a behaviour change to a lane that is currently stable, made without evidence -
                 which is the thing this issue exists to stop doing.

                 The heavy set is tagged @Tag("ha-heavy") at the class, chosen for what a class leaves behind in
                 a shared JVM rather than for its wall clock: RaftMigrationCompactionRaceIT and
                 RaftBulkInsertCompactionRaceIT (72k and 48k records against concurrent compaction),
                 RaftHARandomCrashIT (15k vertices while servers are killed and restarted under it),
                 RaftIndexCompactionReplicationIT (5k records plus index compaction across three servers) and
                 RaftHAComprehensiveIT (the longest-running IT in the module at ~344s of continuous
                 three-server activity).

                 If you touch this block, these are the four things to re-check, none of which fails loudly on
                 its own. Each is one command against a handful of classes rather than the full hour:

                   1. the partition still runs each class exactly once -
                      ./mvnw -o -pl ha-raft verify -Pintegration -DskipTests -DfailIfNoSpecifiedTests=false \
                        -Dit.test=RaftMigrationCompactionRaceIT,RaftVerifyDatabaseIT
                      RaftVerifyDatabaseIT must appear under (default) and RaftMigrationCompactionRaceIT under
                      (heavy-its-in-their-own-fork), each once, and both failsafe-summary files must be written.
                   2. each heavy class still gets its own JVM - add two throwaway tagged ITs that write
                      ProcessHandle.current().pid() to a file, run them, and check the pids differ.
                   3. a failing heavy IT still fails the build AND names this execution - add a throwaway tagged
                      IT that asserts false; the error must read "verify (heavy-its-in-their-own-fork)".
                   4. HeavyForkWiringIT and HeavyItForkIsolationTest are both green.
                   5. no command-line tag filter can narrow either execution - re-run step 1 with
                      -Dgroups=bogus-tag -DexcludedGroups=bogus-tag -Dfailsafe.excludedGroups=ha-heavy and
                      expect the same two classes in the same two forks.

                 Steps 1-3 are how the split was verified in the first place; step 4 is what now watches it. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <!-- The parent's execution, which has no id of its own and so is called "default". Named
                             here only to take the heavy classes off its hands. The two executions are a
                             partition by construction - "everything but the tag" and "only the tag" - so adding
                             a class to the heavy set is one annotation, not two lists that can drift apart.

                             This has to be excludedGroups on the execution rather than an override of the
                             parent's ${failsafe.excludedGroups} property, because the heavy execution below then
                             has no way to opt back in: an empty <excludedGroups/> there resolves through the
                             mojo's own ${failsafe.excludedGroups} default and excludes exactly the classes that
                             execution exists to run, which fails by running nothing and reporting success. -->
                        <id>default</id>
                        <configuration>
                            <!-- "any tag, or no tag" - every class there is. A tautology written out on purpose,
                                 because a parameter left unset is NOT the same as one set to everything: unset,
                                 it resolves through the mojo's ${groups} default and a stray -Dgroups=... on the
                                 command line selects this execution down to whatever that names. Measured on
                                 3.5.6 with -Dgroups=bogus-tag: without this line the execution ran 0 tests and
                                 the build passed, so the ~118 ITs it owns had simply vanished; with it, the same
                                 command runs them all. Explicit configuration wins over a user property, so the
                                 only way to write "everything" such that nothing can narrow it is to say so. -->
                            <groups>any() | none()</groups>
                            <excludedGroups>ha-heavy</excludedGroups>
                            <systemPropertyVariables>
                                <arcadedb.it.fork>default</arcadedb.it.fork>
                            </systemPropertyVariables>
                        </configuration>
                    </execution>
                    <execution>
                        <!-- The heavy classes, a fresh JVM for each - verified by two throwaway ITs that
                             recorded ProcessHandle.current().pid() and got different ones.

                             Its own summary file: failsafe merges into an existing summary rather than replacing
                             it, so sharing the default path would still count both executions, but it would
                             attribute a heavy failure to the "default" execution's verify goal and name the wrong
                             half of the split in the error. A failing heavy IT should say "heavy-its-in-their-
                             own-fork", and with this it does. -->
                        <id>heavy-its-in-their-own-fork</id>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                        <configuration>
                            <groups>ha-heavy</groups>
                            <!-- "tagged and untagged at once" - a contradiction, so it excludes nothing, and the
                                 same reasoning as above in the other direction. Left unset, this resolves through
                                 the parent's ${failsafe.excludedGroups}, and -Dfailsafe.excludedGroups=ha-heavy
                                 would then exclude precisely the five classes this execution exists to run. That
                                 is the worst failure this split has: they are excluded from the default execution
                                 too, so they would not run AT ALL, and failIfNoTests cannot see it (below).
                                 Verified with all three hostile properties at once - -Dgroups, -DexcludedGroups
                                 and -Dfailsafe.excludedGroups - the partition is unchanged. -->
                            <excludedGroups>any() &amp; none()</excludedGroups>
                            <!-- An execution that matches nothing must not pass. Measured rather than assumed,
                                 because this parameter sees less than its name suggests: surefire evaluates it
                                 against the CLASS SCAN, before the provider applies the tag filter. Confirmed
                                 both ways against 3.5.6 - an <includes> pattern matching no file fails the build
                                 with "No tests were executed!", while a <groups> tag matching none of the classes
                                 the scan did find reports "Tests run: 0" and passes.
                                 So it guards the scan-level version of the regression (somebody narrows the
                                 includes, or the ITs move) and cannot guard the likelier one: the tag being
                                 dropped, renamed or mistyped, which puts these classes back in the shared fork
                                 silently. HeavyItForkIsolationTest is the guard for that, and for the finer case
                                 no build-level setting could catch either - one class losing the tag while the
                                 other four keep it.
                                 Harmless to local work: a developer narrowing a run with -Dit.test falls under
                                 failIfNoSpecifiedTests instead, which the default execution's own zero-match runs
                                 already rely on. -->
                            <failIfNoTests>true</failIfNoTests>
                            <reuseForks>false</reuseForks>
                            <!-- Which execution a fork belongs to, so the wiring can check itself. Re-targeting
                                 the parent's unnamed execution by <id>default</id> is correct but obscure Maven
                                 inheritance, and if it ever stopped working these classes would rejoin the shared
                                 fork without anything failing - the pom would still look right and the tags would
                                 still be there, so neither the comment above nor HeavyItForkIsolationTest would
                                 notice. HeavyForkWiringIT reads this property and is itself tagged ha-heavy, so a
                                 broken split lands it in the "default" fork and it says so by name. -->
                            <systemPropertyVariables>
                                <arcadedb.it.fork>ha-heavy</arcadedb.it.fork>
                            </systemPropertyVariables>
                            <summaryFile>${project.build.directory}/failsafe-reports/failsafe-summary-ha-heavy.xml</summaryFile>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
